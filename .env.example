# 이 파일을 복사해서 .env 로 이름을 바꾸고, 값을 채워 넣으세요.
#   copy .env.example .env
#
# .env 는 .gitignore 에 들어 있어서 git 에 올라가지 않습니다.
# 앱 비밀번호는 절대 코드나 커밋에 넣지 마세요.

# ----------------------------------------------------------------- 메일
# console = 터미널에만 링크 출력 (기본값, SMTP 계정 없이 테스트할 때)
# smtp    = 실제로 메일 발송
MAIL_BACKEND=smtp

# 보내는 사람 주소. Gmail 이면 SMTP_USER 와 같은 주소여야 합니다.
MAIL_SENDER=your-address@gmail.com

# Gmail 기준 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com

# Gmail 로그인 비밀번호가 아니라 "앱 비밀번호" 16자리입니다.
# https://myaccount.google.com/apppasswords 에서 직접 발급하세요.
# (2단계 인증이 켜져 있어야 메뉴가 보입니다.)
SMTP_PASSWORD=

# ------------------------------------------------------------- 앱 설정
# 세션 쿠키 서명 키. 아무 긴 랜덤 문자열이면 됩니다.
SECRET_KEY=change-me-to-something-random

# 개발 서버 포트
PORT=5000

# ------------------------------------------------------------- TMDB
# https://www.themoviedb.org/settings/api 에서 발급 (무료, 읽기 전용)
# v3 키(32자)를 여기에 붙여넣으세요.
TMDB_API_KEY=

# v4 읽기 전용 토큰을 쓸 경우에만. 위 키가 있으면 비워두면 됩니다.
TMDB_ACCESS_TOKEN=
